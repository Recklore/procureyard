# Copy to .env (docker compose picks it up for the LLM_* substitutions) or export directly.
# The service runs fully WITHOUT an LLM key — template replies handle every scenario.
DATABASE_URL=postgresql://qd:qd_password@localhost:5432/qd_disputes
PAYSWIFT_BASE_URL=http://localhost:8081

# optional: reply-polish layer only (never supplies amounts/rider ids)
LLM_API_KEY=
LLM_MODEL=gemini-2.0-flash
LLM_PROVIDER=
LLM_BASE_URL=
